APP_ENV=production
WM_BENCH_DATA_ROOT=.
WM_BENCH_RESOURCES_ROOT=./resources
WM_BENCH_RUNS_ROOT=./runs
WM_BENCH_CACHE_ROOT=./runs/materialized-cache
API_HOST=0.0.0.0
API_PORT=6006
WM_BENCH_DEVICE=cpu
WM_BENCH_WORKER_POLL_SECONDS=2
WM_BENCH_VENV=.venv
WM_BENCH_VENV_SYSTEM_SITE_PACKAGES=0
WM_BENCH_INSTALL_SHARP_DEPS=0
WM_BENCH_AUTO_INSTALL_NODE=0
WM_BENCH_NODE_VERSION=20
WM_BENCH_PNPM_VERSION=10.23.0
WM_BENCH_LOG_DIR=./runs/logs
NEXT_PUBLIC_API_BASE_URL=
WM_BENCH_CORS_ORIGINS=http://localhost:6006,http://127.0.0.1:6006
